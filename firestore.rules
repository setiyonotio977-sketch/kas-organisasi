rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function admin() { return signedIn(); }
    match /settings/{id} { allow read: if true; allow write: if admin(); }
    match /members/{id} { allow read: if true; allow write: if admin(); }
    match /structure/{id} { allow read: if true; allow write: if admin(); }
    match /news/{id} { allow read: if true; allow write: if admin(); }
    match /agendas/{id} { allow read: if true; allow write: if admin(); }
    match /albums/{id} { allow read: if true; allow write: if admin(); }
    match /finance/{id} { allow read: if true; allow write: if admin(); }
    match /messages/{id} { allow create: if true; allow read, update, delete: if admin(); }
  }
}
