rules_version = '2';

service cloud.firestore {

  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function admin() {
      return signedIn()
        && get(/databases/$(database)/documents/admins/$(request.auth.uid)).data.enabled == true;
    }

    match /admins/{uid} {
      // Setiap user boleh membaca dokumen admin miliknya sendiri.
      // Ini diperlukan agar login.js bisa mengecek status Admin.
      allow read: if signedIn() && request.auth.uid == uid;

      // Hanya Admin yang sudah terdaftar yang boleh mengubah daftar Admin.
      allow write: if admin();
    }

    match /settings/{id} {
      allow read: if true;
      allow write: if admin();
    }

    match /members/{id} {
      allow read: if true;
      allow write: if admin();
    }

    match /structure/{id} {
      allow read: if true;
      allow write: if admin();
    }

    match /news/{id} {
      allow read: if true;
      allow write: if admin();
    }

    match /agendas/{id} {
      allow read: if true;
      allow write: if admin();
    }

    match /albums/{id} {
      allow read: if true;
      allow write: if admin();
    }

    match /finance/{id} {
      allow read: if true;
      allow write: if admin();
    }

    match /messages/{id} {
      allow create: if true;
      allow read, update, delete: if admin();
    }
  }
}
